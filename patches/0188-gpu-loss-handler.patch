@@ -280,6 +300,14 @@ void GraphicsSystem::OnHostGpuLossFromAnyThread([[maybe_unused]] bool is_respons
   if (host_gpu_loss_reported_.test_and_set(std::memory_order_relaxed)) {
     return;
   }
+  if (const HostGpuLossHandler handler = g_host_gpu_loss_handler.load(std::memory_order_acquire)) {
+    // 0188: no new device here; the command processor has stopped submitting and the app
