+// 0188: what to do on a host GPU loss instead of aborting.
+std::atomic<rex::graphics::HostGpuLossHandler> g_host_gpu_loss_handler{nullptr};
 }  // namespace
 
 namespace rex::graphics {
 
+void SetHostGpuLossHandler(HostGpuLossHandler handler) {
+  g_host_gpu_loss_handler.store(handler, std::memory_order_release);
+}
