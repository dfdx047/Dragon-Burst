 }
 
 u32 NtWaitForMultipleObjectsEx_entry(u32 count, mapped_u32 handles, u32 wait_type, u32 wait_mode,
@@ -977,7 +988,7 @@
     XThread::GetCurrentThread()->DeliverAPCs();
