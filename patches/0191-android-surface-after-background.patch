Dragon Burst 0191: the presenter gets the new Android surface after the background (from DBZ3-Android 0049)

Back from the background (Home, recents, screen off) the Xenia renderer crashed: the presenter was still bound to the
VkSurfaceKHR of the destroyed ANativeWindow, vkCreateSwapchainKHR failed ("Failed to create a swapchain") and a
null pointer was read (SIGSEGV at 0x4), the same in 0.2.0 before the background pause. As in DBZ3-Android 0049: on
SDL_EVENT_WINDOW_MINIMIZED the presenter lets go of the surface, on SDL_EVENT_WINDOW_RESTORED (sent after
surfaceCreated) it takes the new window and paints; the surface keeps its own reference to the ANativeWindow
(ANativeWindow_acquire/release), since SDL releases its one from the Java thread first.

diff --git a/include/rex/ui/surface_android.h b/include/rex/ui/surface_android.h
--- a/include/rex/ui/surface_android.h
+++ b/include/rex/ui/surface_android.h
@@ -17,8 +17,11 @@
 
 class AndroidNativeWindowSurface final : public Surface {
  public:
-  explicit AndroidNativeWindowSurface(ANativeWindow* window, SDL_Window* sdl_window)
-      : window_(window), sdl_window_(sdl_window) {}
+  // DBZ3-Android (0049), Dragon Burst 0191: a superficie guarda a sua propria referencia ao ANativeWindow. O SDL
+  // liberta a dele no surfaceDestroyed (thread Java), antes de a thread da UI desligar o presenter; sem esta
+  // referencia o GetSizeImpl lia uma janela ja libertada.
+  explicit AndroidNativeWindowSurface(ANativeWindow* window, SDL_Window* sdl_window);
+  ~AndroidNativeWindowSurface() override;
   TypeIndex GetType() const override { return kTypeIndex_AndroidNativeWindow; }
   ANativeWindow* window() const { return window_; }
 
diff --git a/src/ui/surface_android.cpp b/src/ui/surface_android.cpp
--- a/src/ui/surface_android.cpp
+++ b/src/ui/surface_android.cpp
@@ -14,6 +14,19 @@
 namespace rex {
 namespace ui {
 
+AndroidNativeWindowSurface::AndroidNativeWindowSurface(ANativeWindow* window, SDL_Window* sdl_window)
+    : window_(window), sdl_window_(sdl_window) {
+  if (window_) {
+    ANativeWindow_acquire(window_);
+  }
+}
+
+AndroidNativeWindowSurface::~AndroidNativeWindowSurface() {
+  if (window_) {
+    ANativeWindow_release(window_);
+  }
+}
+
 bool AndroidNativeWindowSurface::GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const {
   if (window_) {
     const int32_t w = ANativeWindow_getWidth(window_);
