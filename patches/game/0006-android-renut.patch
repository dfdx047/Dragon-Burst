+++ b/src/burstlimit_patches.cpp
@@ -875,8 +875,21 @@
 bool BurstLimitNativeGpuWait();
 #endif
 
+#if defined(DB_RENUT)
+// Dragon Burst: with the Renut (swordman_renderer = renut) the wait is its own (BlockOnFence waits for the render
+// thread); its CBlocker::Check side returns "done" (patches/renut/0100).
+#include "renut_engine/gpu/banjo_renut_select.h"
+extern "C" void renut_native_sub_820B10E8(PPCContext& ctx, uint8_t* base);
+#endif
+
 REX_EXTERN(__imp__sub_820B10E8);
 extern "C" REX_FUNC(sub_820B10E8) {
+#if defined(DB_RENUT)
+  if (banjo::renut_gpu::Active()) {
+    renut_native_sub_820B10E8(ctx, base);
+    return;
+  }
+#endif
   if (BurstLimitNativeGpuWait()) {
     // The original keeps its hang check and returns "keep waiting".
     __imp__sub_820B10E8(ctx, base);
