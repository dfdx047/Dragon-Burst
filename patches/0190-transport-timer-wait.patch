   std::mutex timer_mutex_;
   std::vector<Job> jobs_;  // min-heap
   uint64_t job_order_ = 0;
+  std::condition_variable timer_cv_;  // POSIX (Dragon Burst 0190): a queued job wakes TimerLoop
   void* timer_ = nullptr;
   void* wake_ = nullptr;
   bool high_resolution_ = false;
