   FrameFit fit;
   fit.viewport = plume::RenderViewport(0.0f, 0.0f, float(out_w), float(out_h));
+  // Dragon Burst: the surface the frame goes to, for aspect_ratio = auto (the screen's shape).
+  rex::graphics::SetOutputSurfaceSize(out_w, out_h);
   if (src_w == 0 || src_h == 0 || out_w == 0 || out_h == 0 || REXCVAR_GET(swordman_aspect) == "stretch")
     return fit;
   const float out_aspect = float(out_w) / float(out_h);
-  const float src_aspect = float(src_w) / float(src_h);
+  float src_aspect = float(src_w) / float(src_h);
+  // Dragon Burst (2026-10-29, widescreen): Burst Limit draws a wider view into its 1280x720 frame (aspect_ratio,
+  // rex/graphics/wide_aspect.h), shown at that shape: stretched across (anamorphic), its 2D kept in shape by the draws
+  // (PlaceOverlayDraw in render/draw.cpp).
+  if (const float display = rex::graphics::GetGuestDisplayAspect(); display > src_aspect + 0.01f)
+    src_aspect = display;
   // Within half a percent: a frame of the screen's shape whose width was rounded to 16.
   if (std::fabs(src_aspect / out_aspect - 1.0f) < 0.005f)
     return fit;
