+// Dragon Burst (2026-10-29, widescreen): the game's 2D in a wider picture (rex/graphics/wide_aspect.h). With
+// aspect_ratio wider than 16:9 Burst Limit draws a wider view into its 1280x720 frame, which the present stretches to
+// the screen's shape, and its 2D would stretch with it: for a draw over the main target with its viewport on the whole
+// 1280 columns and the depth test off or always passing (the HUD, menus, full-screen passes), the game says where its
+// clip X goes (x * scale_x + offset_x, burstlimit_widescreen.cpp's PlaceOverlay), as the PC's D3D12 path asks it. The
+// viewport and the scissor take it.
+void PlaceOverlayDraw(const u8 *device_state, const GuestDevice &device, const DrawCall &call,
+                      const ReplayConstants *replay, const ShaderRecord &vs, const ShaderRecord *ps,
+                      const Targets &targets, ViewportState &viewport) {
+  constexpr uint32_t kFrontWidth = 1280, kFrontHeight = 720;
+  const rex::graphics::OverlayPlacementCallback callback = rex::graphics::GetOverlayPlacementCallback();
+  if (!callback || targets.guest_width < kFrontWidth)
+    return;
+  const float host_width = float(targets.scale.Size(kFrontWidth));
+  const float slack = targets.scale.Factor();
+  plume::RenderViewport &v = viewport.viewport;
+  if (std::fabs(v.x) > slack || std::fabs(std::fabs(v.width) - host_width) > slack)
+    return;
+  // RB_DEPTHCONTROL: z_enable bit 1, zfunc bits 4-6 (7 = always); the game's, in RB_MODECONTROL's color + depth mode
+  // (edram_mode 4), bound depth target or not, as the emulated path's normalized depth control takes it.
+  const u32 depth_control =
+      (u32(device.dev().m_ControlPacket.ModeControl) & 7) == 4 ? u32(device.dev().m_ControlPacket.DepthControl) : 0;
+  const bool depth_test = (depth_control & 2) != 0;
+  if (depth_test && ((depth_control >> 4) & 7) != 7 &&
+      !(ps && rex::graphics::IsOverlayDepthTestedPixelShader(ps->ucode_hash)))
+    return;
+  rex::graphics::OverlayDrawInfo info;
+  info.vertex_shader_hash = vs.ucode_hash;
+  info.pixel_shader_hash = ps ? ps->ucode_hash : 0;
+  const FloatConstants constants = DrawFloatConstants(device_state, replay, false);
+  for (u32 r = 0; r < 8; ++r) {
+    const u8 *words = constants.Register(r);
+    for (u32 i = 0; i < 4; ++i) {
+      u32 word;
+      std::memcpy(&word, words + 4 * i, 4);
+      word = __builtin_bswap32(word);
+      std::memcpy(&info.vertex_constants[r * 4 + i], &word, 4);
+    }
+  }
+  const TextureFetch fetch = DeviceTextureFetch(device.dev(), 0);
+  if (fetch.IsTexture() && fetch.Dimension() == TextureDimension::Tex2D) {
+    info.texture0_width = (fetch.dword[2] & 0x1FFF) + 1;
+    info.texture0_height = ((fetch.dword[2] >> 13) & 0x1FFF) + 1;
+  }
+  // Big-endian as in guest memory (the game's 2D streams and Begin*Vertices are 8in32).
+  const StreamSource stream = GetStreamSource(device, call, vs, nullptr, 0);
+  if (stream.data && stream.stride && stream.vertex_count) {
+    info.vertex_data = stream.data;
+    info.vertex_data_size = stream.vertex_count * stream.stride;
+  }
+  info.depth_test = depth_test;
+  info.primitive_type = call.primitive;
+  info.vertex_count = call.count;
+  info.frontbuffer_width = kFrontWidth;
+  info.frontbuffer_height = kFrontHeight;
+  const rex::graphics::OverlayPlacement placement = callback(info);
+  if (placement.scale_x == 1.0f && placement.offset_x == 0.0f)
+    return;
+  // Clip X -> x * s + o around the viewport's center: the center moves by o half-widths and the width scales by s.
+  const float half = 0.5f * v.width;
+  const float center = v.x + half;
+  v.x = center + placement.offset_x * half - placement.scale_x * half;
+  v.width *= placement.scale_x;
+  float left = center + (float(viewport.scissor.left) - center) * placement.scale_x + placement.offset_x * half;
+  float right = center + (float(viewport.scissor.right) - center) * placement.scale_x + placement.offset_x * half;
+  if (left > right)
+    std::swap(left, right);
+  const float target_width = float(targets.scale.Size(targets.width));
+  viewport.scissor.left = int32_t(std::clamp(std::floor(left), 0.0f, target_width));
+  viewport.scissor.right = std::max(viewport.scissor.left, int32_t(std::clamp(std::ceil(right), 0.0f, target_width)));
+}
