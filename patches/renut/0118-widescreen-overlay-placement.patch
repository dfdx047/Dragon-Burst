     viewport.scissor.right = std::min(viewport.scissor.right, int32_t(targets.scale.Size(1280)));
   }
+  // Dragon Burst (2026-10-29, widescreen): PlaceOverlayDraw.
+  if (vs && !viewport.screen_space && rex::graphics::GetGuestDisplayAspect() > 16.0f / 9.0f + 0.01f)
+    PlaceOverlayDraw(device_state, device, call, replay, *vs, ps, targets, viewport);
   sc.screen_space = viewport.screen_space ? 1 : 0;
   std::memcpy(sc.screen_scale, viewport.screen_scale, sizeof(sc.screen_scale));
   std::memcpy(sc.screen_offset, viewport.screen_offset, sizeof(sc.screen_offset));
