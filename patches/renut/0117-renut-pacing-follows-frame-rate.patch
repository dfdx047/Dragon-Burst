@@ -55,7 +56,14 @@
 
 using Clock = std::chrono::steady_clock;
 constexpr uint32_t kDeviceOffsetPresentationInterval = 13596;  // Dragon Burst: BL (N&B)  // the device's copy of D3DPRESENT_PARAMETERS + 52
-constexpr Clock::duration kRefresh = std::chrono::duration_cast<Clock::duration>(std::chrono::duration<double>(1.0 / 60.0));
+// Dragon Burst (renut/0117): one refresh of the rate the game asked for (burstlimit_patches frame_rate: 60, 120, 144, or
+// 1000 for unlocked, through rex::graphics::SetGuestVblankRate), not a fixed 60 Hz, which held 120 FPS and unlocked at 60
+// on the Renut. As on Xenia, the fight keeps its 60 Hz tick at those rates (burstlimit_patches). Unknown (0) = 60 Hz.
+Clock::duration Refresh() {
+  const double hz = rex::graphics::GetGuestVblankRate();
+  return std::chrono::duration_cast<Clock::duration>(
+      std::chrono::duration<double>(1.0 / (hz >= 1.0 && hz <= 1000.0 ? hz : 60.0)));
+}
 
