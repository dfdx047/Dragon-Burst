+uint64_t HashShaderUcode(const uint8_t *container) {
+  const auto *header = reinterpret_cast<const d3d::ShaderContainer *>(container);
+  const u32 virtual_size = header->virtualSize, physical_size = header->physicalSize;
+  const u32 shader_offset = header->shaderOffset;
+  if (shader_offset + 8 > virtual_size)
+    return 0;
+  const auto *words = reinterpret_cast<const be_u32 *>(container + shader_offset);
+  const u32 offset = words[0], size = words[1];
+  if (u64(offset) + size > physical_size)
+    return 0;
+  return XXH3_64bits(container + virtual_size + offset, size);
+}
