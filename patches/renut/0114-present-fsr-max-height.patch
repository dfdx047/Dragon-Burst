+// Dragon Burst (kFsrScaled): RCAS's image, as EnsureEffectTarget.
+bool EnsureSharpTarget(VideoState &s, uint32_t w, uint32_t h) {
+  PresentEffect &e = g_effect;
+  if (e.sharp && e.sharp_width == w && e.sharp_height == h)
+    return true;
+  if (e.sharp) {
+    detail::WaitAllSubmitted(s);
+    WaitInterpListsLocked(s);
+  }
+  e.sharp_framebuffer.reset();
+  e.sharp_view.reset();
+  e.sharp.reset();
+  e.sharp_width = e.sharp_height = 0;
+  plume::RenderTextureDesc desc = plume::RenderTextureDesc::Texture2D(w, h, 1, kEffectFormat);
+  desc.flags |= plume::RenderTextureFlag::RENDER_TARGET;
+  e.sharp = s.device->createTexture(desc);
+  if (!e.sharp)
+    return false;
+  e.sharp->setName("renut present FSR image (RCAS)");
+  e.sharp_view = e.sharp->createTextureView(plume::RenderTextureViewDesc::Texture2D(kEffectFormat));
+  const plume::RenderTexture *attachment = e.sharp.get();
+  e.sharp_framebuffer = s.device->createFramebuffer(plume::RenderFramebufferDesc(&attachment, 1));
+  if (e.sharp_slot == kInvalidDescriptor)
+    e.sharp_slot = Video::AllocateTextureSlotLocked();
+  if (!e.sharp_view || !e.sharp_framebuffer || e.sharp_slot == kInvalidDescriptor) {
+    e.sharp_framebuffer.reset();
+    e.sharp_view.reset();
+    e.sharp.reset();
+    return false;
+  }
+  Video::SetTextureSlotLocked(e.sharp_slot, e.sharp.get(), e.sharp_view.get());
+  e.sharp_width = w;
+  e.sharp_height = h;
+  RGPU_INFO("present_effect: FSR at {}x{}, bilinear to the screen (swordman_renut_fsr_max_height)", w, h);
+  return true;
+}
