+// Dragon Burst (diagnostic, swordman_renut_diag_vs): the vertex shader's vfetch instructions as the game's Direct3D
+// last patched them, i.e. what the GPU (and Xenia) executes: per element the fetch constant, format, sign, number
+// format, signed mode, exponent adjust, destination swizzle, offset and stride.
+std::string DescribePatchedFetch(u32 vs_va) {
+  const auto *object = GuestPtr<const u8>(vs_va);
+  if (!object)
+    return "no object";
+  auto word_at = [](const u8 *p) { return u32(*reinterpret_cast<const be_u32 *>(p)); };
+  const u32 physical_va = word_at(object + 32);
+  const u8 *container = object + kVertexShaderContainer;
+  const u8 *header = container + word_at(container + 0x18);
+  const u32 skip = word_at(header + 0x18), count = word_at(header + 0x1C);
+  if (!physical_va || !count || count > 32 || skip > 64)
+    return "no vfetch elements";
+  const u8 *physical = physical_va < 0x20000000u ? GuestPhysicalPtr<const u8>(physical_va)
+                                                 : GuestPtr<const u8>(physical_va);
+  if (!physical)
+    return "no microcode";
+  physical += word_at(header);
+  std::string out;
+  for (u32 i = 0; i < count; ++i) {
+    const u32 e = word_at(header + 0x24 + (skip + i) * 4);
+    const u32 address = e & 0xFFF;
+    const u32 w0 = word_at(physical + address * 12), w1 = word_at(physical + address * 12 + 4),
+              w2 = word_at(physical + address * 12 + 8);
+    std::string swizzle;
+    for (u32 c = 0; c < 4; ++c)
+      swizzle += "xyzw01?_"[(w1 >> (c * 3)) & 7];
+    out += fmt::format(" | u{}.{} @{:03X} const {} fmt {} signed {} int {} rf {} exp {} swz {} off {} stride {}{}",
+                       (e >> 12) & 0xF, (e >> 16) & 0xF, address, ((w0 >> 20) & 0x1F) * 3 + ((w0 >> 25) & 3),
+                       (w1 >> 16) & 0x3F, (w1 >> 12) & 1, (w1 >> 13) & 1, (w1 >> 14) & 1,
+                       i32(w1 << 2) >> 26, swizzle, i32(w2 << 1) >> 9, w2 & 0xFF, ((w1 >> 30) & 1) ? " mini" : "");
+  }
+  return out;
+}
