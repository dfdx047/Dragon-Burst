+void SetUIWatchdogBackground(bool background) {
+  if (!background) {
+    int64_t since = g_busy_since_ms.load(std::memory_order_acquire);
+    if (since != 0) {
+      g_busy_since_ms.compare_exchange_strong(since, NowMs(), std::memory_order_acq_rel);
+    }
+  }
+  g_background.store(background, std::memory_order_release);
+}
